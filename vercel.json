{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pages/:path*",
      "destination": "/sivut/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-panel",
      "destination": "/admin-panel/index.html"
    },
    {
      "source": "/admin-panel/(.*)",
      "destination": "/admin-panel/$1"
    }
  ],
  "headers": [
    {
      "source": "/admin-panel/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
